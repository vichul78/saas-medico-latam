# Supabase (proyecto LatAm)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Región/moneda por defecto del tenant (ISO 4217). Ej: MXN, ARS, COP, PEN, CLP, BRL, UYU, BOB, PYG, VES, USD
VITE_DEFAULT_CURRENCY=MXN
VITE_DEFAULT_LOCALE=es-MX

# Twilio WhatsApp API
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Twilio WhatsApp API (client-side, SOLO desarrollo)
VITE_TWILIO_ACCOUNT_SID=
VITE_TWILIO_AUTH_TOKEN=
VITE_TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# URL publica del sitio (para links compartidos)
VITE_PUBLIC_URL=https://app.medicolatam.com
